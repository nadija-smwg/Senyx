# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# application logs (not suitable for git — use an external logging service)
error.log
tsout.txt
*.log

# root-level debug/fix scripts (development artifacts)
cleanup.ts
fix-constraint.ts
fix-type-constraint.ts
fix_balances.ts
test-create.ts
test-insert.ts
test-insert2.ts
test-query.ts
test-query2.ts
